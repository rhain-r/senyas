<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp"><shape><solid android:color="@color/surface" /><corners android:radius="16dp" /><stroke android:width="2dp" android:color="@color/card_stroke" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="@color/card_stroke" /><corners android:radius="16dp" /></shape></item>
            <item android:bottom="4dp"><shape><solid android:color="@color/surface" /><corners android:radius="16dp" /><stroke android:width="2dp" android:color="@color/card_stroke" /></shape></item>
        </layer-list>
    </item>
</selector>
