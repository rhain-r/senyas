<resources>
    <style name="Theme.Senyas" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/senyas_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_container</item>
        <item name="colorOnPrimaryContainer">@color/senyas_blue</item>
        <item name="colorSecondary">@color/sun_yellow</item>
        <item name="colorOnSecondary">@color/navy</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="textInputStyle">@style/Widget.Senyas.TextField</item>
    </style>

    <style name="Widget.Senyas.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.Senyas.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Sign Lab: always dark, like the Practice Room, so the camera stands out. -->
    <style name="Theme.Senyas.Lab" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/navy</item>
        <item name="colorSecondary">@color/sun_yellow</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/text_on_dark</item>
        <item name="colorOutline">@color/text_on_dark</item>
        <item name="textInputStyle">@style/Widget.Senyas.TextField.Lab</item>
    </style>

    <style name="Widget.Senyas.TextField.Lab" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.Senyas.Button.Lab" parent="Widget.Material3.Button">
        <item name="android:checkable">true</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/lab_button_bg</item>
        <item name="android:textColor">@color/lab_button_text</item>
    </style>

    <style name="Theme.Senyas.Splash" parent="Theme.Senyas">
        <item name="android:windowBackground">@color/senyas_icon_bg</item>
        <item name="android:statusBarColor">@color/senyas_icon_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
