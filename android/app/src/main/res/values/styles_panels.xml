<?xml version="1.0" encoding="utf-8"?>
<!-- The panel under a booking step: what was chosen above the button that continues.
     values-land puts both on one row so the short landscape screen keeps room for the step. -->
<resources>
    <style name="Senyas.ActionPanel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/surface</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Senyas.ActionPanelInfo" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Senyas.ActionPanelButton" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
