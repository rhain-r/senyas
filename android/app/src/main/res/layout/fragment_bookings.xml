<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Shown by BookingsFragment (a pushed screen). TutorSessionsFragment (a tab) keeps tv_page_title. -->
    <include
        android:id="@+id/top_bar"
        layout="@layout/view_top_bar"
        android:visibility="gone" />

    <TextView android:id="@+id/tv_page_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:paddingTop="16dp" android:text="@string/my_bookings" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_upcoming" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_weight="1" android:text="@string/upcoming" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_past" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_weight="1" android:text="@string/past" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:id="@+id/empty_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView android:id="@+id/tv_empty_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_empty_body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="15sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_find" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="@string/find_a_tutor" android:textStyle="bold" app:cornerRadius="16dp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
