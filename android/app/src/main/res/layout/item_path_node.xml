<?xml version="1.0" encoding="utf-8"?>
<!-- One sign on the learning path: done (blue check), current (yellow hand + START) or locked (grey padlock). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/node_col"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_start_label"
            android:importantForAccessibility="no"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:text="@string/path_start"
            android:textAllCaps="true"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/node"
            android:layout_width="78dp"
            android:layout_height="84dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/node_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginBottom="6dp"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
