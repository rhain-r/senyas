<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <FrameLayout android:id="@+id/tile_cover" android:layout_width="0dp" android:layout_height="120dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_tile" android:backgroundTint="@color/skeleton">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cover_photo" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_cover_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout android:id="@+id/tile_preview" android:layout_width="0dp" android:layout_height="120dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_tile" android:backgroundTint="@color/skeleton">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/signed_preview" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_preview_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_media" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="@string/add_replace_media" android:textSize="16sp" android:textStyle="bold" app:cornerRadius="16dp" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/city_location">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:id="@+id/btn_gps" android:layout_width="wrap_content" android:layout_height="48dp" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:paddingHorizontal="4dp" android:text="@string/use_gps" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/media_days_label" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/cg_days" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/tv_days_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/err_days" android:textColor="?attr/colorError" android:textSize="13sp" android:visibility="gone" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/media_times_label" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/media_times_help" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/cg_times" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_time" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="4dp" android:text="@string/add_time" app:cornerRadius="16dp" app:icon="@drawable/ic_add" />
            <TextView android:id="@+id/tv_times_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/err_times" android:textColor="?attr/colorError" android:textSize="13sp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton android:id="@+id/btn_publish" android:layout_width="match_parent" android:layout_height="56dp" android:layout_margin="16dp" android:textSize="16sp" android:textStyle="bold" app:cornerRadius="16dp" />
</LinearLayout>
