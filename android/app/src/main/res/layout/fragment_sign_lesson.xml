<?xml version="1.0" encoding="utf-8"?>
<!-- "Learn this sign": the signed video in a 3D card, the word, slow motion and captions, then
     "I'm ready" to practise it (or "Done" for a dictionary sign with no scenario). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="-8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close"
                    android:src="@drawable/ic_close"
                    android:tint="@color/outline" />

                <!-- Position in the scenario; invisible for a dictionary sign. -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/lesson_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:max="100"
                    app:indicatorColor="@color/senyas_blue"
                    app:trackColor="@color/blue_container"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="14dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_bar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/learn_this_sign"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- The signed demonstration. The video sits on the card's face, above its 3D edge. -->
            <FrameLayout
                android:id="@+id/video_box"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_hand_card"
                android:contentDescription="@string/signed_lesson_video_placeholder">

                <com.benten.senyas.SignVideoView
                    android:id="@+id/sign_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/video_placeholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/iv_play"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_play"
                        app:tint="@color/accent" />

                    <TextView
                        android:id="@+id/tv_video_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/signed_lesson_video_play"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Caption: the word and its meaning. -->
                <TextView
                    android:id="@+id/tv_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_tag_label"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/navy"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_video_credit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/video_credit_fsl105"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_replay"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_play_btn"
                    android:clickable="true"
                    android:contentDescription="@string/replay"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_play"
                        app:tint="@color/accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_word"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_translation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Half speed, to see the movement clearly. -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_slow"
                    style="@style/Widget.Senyas.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:checkable="true"
                    android:text="@string/slow_motion" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_captions"
                    style="@style/Widget.Senyas.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/captions" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btn_practice"
            style="@style/Widget.Senyas.Btn3D.Primary"
            android:text="@string/im_ready" />

        <TextView
            android:id="@+id/btn_watch_again"
            style="@style/Widget.Senyas.LinkBtn"
            android:layout_marginTop="4dp"
            android:text="@string/watch_again" />
    </LinearLayout>
</LinearLayout>
