<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/dark_bg" android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/blocked_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/session_unavailable_title" android:textColor="@color/white"
        android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/session_blocked_message" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:text="@string/session_not_open" android:textColor="@color/text_on_dark" android:textSize="16sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_back"
        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp"
        android:text="@string/close" />
</LinearLayout>
