<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: the tabs move to a rail at the side, so screens keep the whole height of the phone.
     Same look as the portrait bar: icons only, outlined box on the active tab, divider beside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="horizontal">

    <!-- Takes the start-side system inset (camera cutout or 3-button bar) so the rail colour reaches the edge. -->
    <LinearLayout
        android:id="@+id/nav_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:orientation="horizontal">

        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/bottom_nav"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="80dp"
            android:background="@color/surface"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@style/Widget.Senyas.NavIndicator"
            app:itemBackground="@drawable/nav_item_bg"
            app:itemIconSize="28dp"
            app:itemIconTint="@color/nav_icon_tint"
            app:itemMinHeight="60dp"
            app:labelVisibilityMode="unlabeled"
            app:menu="@menu/bottom_nav_menu"
            app:menuGravity="center"
            app:paddingBottomSystemWindowInsets="false"
            app:paddingStartSystemWindowInsets="false"
            app:paddingTopSystemWindowInsets="false" />

        <View
            android:id="@+id/nav_divider"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/card_stroke" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/nav_host"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
