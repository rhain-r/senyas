<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: the camera tile sits beside the explanation, and the two buttons share one row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tile"
            android:backgroundTint="@color/skeleton"
            android:contentDescription="@string/camera_access_is_off">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/camera_access_is_off" android:textColor="@color/text_primary" android:textSize="14sp" />
        </FrameLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/allow_access_to_practice" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/enable_camera_access_in_your" android:textColor="@color/text_secondary" android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_watch" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="@string/watch_the_lesson_instead" android:textSize="16sp" android:textStyle="bold" app:cornerRadius="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_settings" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/open_camera_settings" android:textSize="16sp" android:textStyle="bold" app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
